#!/bin/bash

PROFILE_PATH="/sys/firmware/acpi/platform_profile"
PROFILE_CHOICES="${PROFILE_PATH}_choices"
CONFIG_DIR="${HOME}/.config/predator-mode"
CONFIG_FILE="${CONFIG_DIR}/config"
SCRIPT_PATH="$(realpath "$0")"
REPO_RAW="https://raw.githubusercontent.com/wizsaint/predator-mode/main"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# Check sysfs interface exists (skip for non-profile commands)
case "${1}" in
    enable|disable|service|update|-h|--help)
        ;;
    *)
        if [ ! -f "$PROFILE_PATH" ]; then
            echo -e "${RED}Error:${NC} ACPI platform_profile interface not found."
            echo "Your kernel may not support platform profiles."
            exit 1
        fi
        ;;
esac

AVAILABLE=$(cat "$PROFILE_CHOICES" 2>/dev/null)

get_default() {
    local DEFAULT="balanced-performance"
    if [ -f "$CONFIG_FILE" ]; then
        local SAVED
        SAVED=$(grep -m1 "^default=" "$CONFIG_FILE" | cut -d'=' -f2)
        if [ -n "$SAVED" ] && echo "$AVAILABLE" | grep -qw "$SAVED"; then
            DEFAULT="$SAVED"
        elif [ -n "$SAVED" ]; then
            echo -e "${YELLOW}Warning:${NC} Saved default '$SAVED' is not a valid profile. Falling back to 'balanced-performance'." >&2
        fi
    fi
    echo "$DEFAULT"
}

notify() {
    local PROFILE="$1"
    if command -v notify-send &>/dev/null; then
        notify-send \
            --app-name="predator-mode" \
            --icon=battery-symbolic \
            --urgency=low \
            --expire-time=2000 \
            "Power Profile" "Switched to: ${PROFILE}"
    fi
}

show_help() {
    echo -e "${BOLD}predator-mode${NC} — Acer Predator platform profile switcher"
    echo ""
    echo -e "${BOLD}Profile commands:${NC}"
    echo "  predator-mode [profile]       Set a profile (uses saved default if none given)"
    echo "  predator-mode -c              Cycle to the next profile"
    echo "  predator-mode -s              Show current and default profile"
    echo "  predator-mode -l              List available profiles"
    echo "  predator-mode -d [profile]    Set or show default profile"
    echo ""
    echo -e "${BOLD}Service commands:${NC}"
    echo "  predator-mode enable          Enable and start the login service"
    echo "  predator-mode disable         Disable and stop the login service"
    echo "  predator-mode service         Show service status"
    echo ""
    echo -e "${BOLD}Other:${NC}"
    echo "  predator-mode update          Update to the latest version from GitHub"
    echo "  predator-mode -h              Show this help"
    echo ""
    echo -e "${BOLD}Available profiles:${NC}"
    for p in $AVAILABLE; do echo "  $p"; done
}

show_status() {
    CURRENT=$(cat "$PROFILE_PATH")
    DEFAULT=$(get_default)
    echo -e "Current profile: ${GREEN}${BOLD}${CURRENT}${NC}"
    echo -e "Default profile: ${CYAN}${DEFAULT}${NC}"
}

show_list() {
    CURRENT=$(cat "$PROFILE_PATH")
    DEFAULT=$(get_default)
    echo -e "${BOLD}Available profiles:${NC}"
    for p in $AVAILABLE; do
        if [ "$p" = "$CURRENT" ] && [ "$p" = "$DEFAULT" ]; then
            echo -e "${GREEN}  ▶ $p${NC} ${YELLOW}[active · default]${NC}"
        elif [ "$p" = "$CURRENT" ]; then
            echo -e "${GREEN}  ▶ $p [active]${NC}"
        elif [ "$p" = "$DEFAULT" ]; then
            echo -e "    $p ${YELLOW}[default]${NC}"
        else
            echo "    $p"
        fi
    done
}

cycle_profile() {
    CURRENT=$(cat "$PROFILE_PATH")
    PROFILES=($AVAILABLE)
    COUNT=${#PROFILES[@]}
    NEXT=""

    for i in "${!PROFILES[@]}"; do
        if [ "${PROFILES[$i]}" = "$CURRENT" ]; then
            NEXT="${PROFILES[$(( (i + 1) % COUNT ))]}"
            break
        fi
    done

    [ -z "$NEXT" ] && NEXT="${PROFILES[0]}"
    set_profile "$NEXT"
}

set_default() {
    local PROFILE="$1"

    if ! echo "$AVAILABLE" | grep -qw "$PROFILE"; then
        echo -e "${RED}Error:${NC} '$PROFILE' is not a valid profile."
        echo -e "Run ${CYAN}predator-mode -l${NC} to see available profiles."
        exit 1
    fi

    mkdir -p "$CONFIG_DIR"
    echo "default=${PROFILE}" > "$CONFIG_FILE"
    echo -e "Default profile set to: ${CYAN}${BOLD}${PROFILE}${NC}"
    echo -e "The systemd service will use this on next login."
}

set_profile() {
    local PROFILE="$1"

    if ! echo "$AVAILABLE" | grep -qw "$PROFILE"; then
        echo -e "${RED}Error:${NC} '$PROFILE' is not a valid profile."
        echo -e "Run ${CYAN}predator-mode -l${NC} to see available profiles."
        exit 1
    fi

    if echo "$PROFILE" | sudo tee "$PROFILE_PATH" > /dev/null; then
        echo -e "Profile set to: ${GREEN}${BOLD}${PROFILE}${NC}"
        notify "$PROFILE"
    else
        echo -e "${RED}Error:${NC} Failed to set profile. Check your sudoers rule."
        exit 1
    fi
}

service_enable() {
    systemctl --user enable --now predator-profile.service \
        && echo -e "  ${GREEN}✔${NC} Service enabled and started" \
        || echo -e "  ${RED}✘${NC} Failed to enable service"
}

service_disable() {
    systemctl --user disable --now predator-profile.service \
        && echo -e "  ${GREEN}✔${NC} Service disabled and stopped" \
        || echo -e "  ${RED}✘${NC} Failed to disable service"
}

service_status() {
    systemctl --user status predator-profile.service --no-pager -l
}

self_update() {
    echo -e "Checking for updates..."

    local TMP
    TMP=$(mktemp)

    if ! curl -fsSL "${REPO_RAW}/predator-mode" -o "$TMP"; then
        rm -f "$TMP"
        echo -e "${RED}Error:${NC} Failed to download update. Check your internet connection."
        exit 1
    fi

    # Validate the downloaded file looks like our script
    if ! head -1 "$TMP" | grep -q "#!/bin/bash"; then
        rm -f "$TMP"
        echo -e "${RED}Error:${NC} Downloaded file doesn't look valid. Aborting."
        exit 1
    fi

    # Backup current version
    cp "$SCRIPT_PATH" "${SCRIPT_PATH}.bak"

    # Replace in place
    chmod +x "$TMP"
    mv "$TMP" "$SCRIPT_PATH"

    echo -e "  ${GREEN}✔${NC} Updated successfully: ${SCRIPT_PATH}"
    echo -e "  ${CYAN}ℹ${NC}  Previous version backed up to: ${SCRIPT_PATH}.bak"
}

case "${1}" in
    -h|--help)    show_help ;;
    -s|--status)  show_status ;;
    -l|--list)    show_list ;;
    -c|--cycle)   cycle_profile ;;
    -d|--default)
        if [ -z "$2" ]; then
            echo -e "Current default: ${CYAN}$(get_default)${NC}"
        else
            set_default "$2"
        fi
        ;;
    enable)       service_enable ;;
    disable)      service_disable ;;
    service)      service_status ;;
    update)       self_update ;;
    "")           set_profile "$(get_default)" ;;
    *)            set_profile "$1" ;;
esac
