#!/bin/bash
# predator-mode — ACPI platform profile switcher for the Acer Predator Helios Neo 16
# https://github.com/wizsaint/predator-mode
#
# Installing and updating is the installer's job (install-predator-mode.sh).
# This script only switches profiles and manages the login service.

VERSION="2.1.0"

PROFILE_PATH="/sys/firmware/acpi/platform_profile"
CONFIG_FILE="$HOME/.config/predator-mode/config"
SERVICE="predator-profile.service"

AVAILABLE=$(cat "${PROFILE_PATH}_choices" 2>/dev/null)

# Colour only when a person is looking (not in logs, pipes or the login service)
BOLD='' GREEN='' YELLOW='' CYAN='' RED='' NC=''
if [ -z "${NO_COLOR:-}" ] && [ -t 1 ] && [ -t 2 ]; then
    BOLD=$'\033[1m' GREEN=$'\033[32m' YELLOW=$'\033[33m'
    CYAN=$'\033[36m' RED=$'\033[31m' NC=$'\033[0m'
fi

err()  { echo "${RED}Error:${NC} $*" >&2; }
warn() { echo "${YELLOW}Warning:${NC} $*" >&2; }

# ── Profiles ──────────────────────────────────────────────────────────────────

# Exact match only: a substring match would accept "power" because of "low-power"
is_valid() {
    local p
    for p in $AVAILABLE; do
        [ "$p" = "$1" ] && return 0
    done
    return 1
}

require_valid() {
    is_valid "$1" && return 0
    err "'$1' is not a valid profile."
    echo "Available: $AVAILABLE" >&2
    exit 1
}

get_current() { cat "$PROFILE_PATH"; }

get_default() {
    local saved="" fallback=balanced
    is_valid balanced-performance && fallback=balanced-performance
    [ -r "$CONFIG_FILE" ] && saved=$(grep -m1 '^default=' "$CONFIG_FILE" | cut -d= -f2-)
    if [ -z "$saved" ]; then
        echo "$fallback"
    elif is_valid "$saved"; then
        echo "$saved"
    else
        warn "saved default '$saved' is not available on this machine; using '$fallback'."
        echo "$fallback"
    fi
}

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send --app-name=predator-mode --icon=battery-symbolic \
        --urgency=low --expire-time=2000 \
        "Power Profile" "Switched to: $1" 2>/dev/null || true
}

set_profile() {
    require_valid "$1"
    # -n: never prompt. Without the sudoers rule this fails fast instead of hanging.
    if sudo -n tee "$PROFILE_PATH" <<<"$1" >/dev/null 2>&1; then
        echo "Profile set to: ${GREEN}${BOLD}$1${NC}"
        # Applying the default (login service) stays silent; explicit switches notify
        [ "${2:-}" = silent ] || notify "$1"
    else
        err "could not write to $PROFILE_PATH."
        echo "The sudoers rule is probably missing. Re-run the installer to repair it." >&2
        exit 1
    fi
}

cycle_profile() {
    local current p first="" next="" found=0
    current=$(get_current)
    for p in $AVAILABLE; do
        [ -z "$first" ] && first=$p
        if [ "$found" = 1 ]; then next=$p; break; fi
        [ "$p" = "$current" ] && found=1
    done
    set_profile "${next:-$first}"
}

set_default() {
    require_valid "$1"
    mkdir -p "$(dirname "$CONFIG_FILE")"
    echo "default=$1" > "$CONFIG_FILE"
    echo "Default profile set to: ${CYAN}${BOLD}$1${NC}"
    echo "Applied at next login, or run 'predator-mode' to apply it now."
}

show_list() {
    local current default p
    current=$(get_current)
    default=$(get_default)
    for p in $AVAILABLE; do
        if [ "$p" = "$current" ] && [ "$p" = "$default" ]; then
            echo "${GREEN}  ▶ $p${NC} ${YELLOW}[active · default]${NC}"
        elif [ "$p" = "$current" ]; then
            echo "${GREEN}  ▶ $p${NC} ${YELLOW}[active]${NC}"
        elif [ "$p" = "$default" ]; then
            echo "    $p ${YELLOW}[default]${NC}"
        else
            echo "    $p"
        fi
    done
}

# ── Login service ─────────────────────────────────────────────────────────────

service_state() {
    local s
    s=$(systemctl --user is-enabled "$SERVICE" 2>/dev/null)
    echo "${s:-not installed}"
}

show_status() {
    echo "Current profile: ${GREEN}${BOLD}$(get_current)${NC}"
    echo "Default profile: ${CYAN}$(get_default)${NC}"
    echo "Login service:   $(service_state)"
}

service_enable() {
    if systemctl --user enable --now "$SERVICE"; then
        echo "Login service enabled."
    else
        err "could not enable $SERVICE. Is it installed? Re-run the installer."
        exit 1
    fi
}

service_disable() {
    if systemctl --user disable --now "$SERVICE"; then
        echo "Login service disabled."
    else
        err "could not disable $SERVICE."
        exit 1
    fi
}

# ── Help ──────────────────────────────────────────────────────────────────────

show_help() {
    cat <<EOF
${BOLD}predator-mode${NC} $VERSION — Acer Predator platform profile switcher

${BOLD}Usage:${NC}
  predator-mode [profile]      Set a profile (no argument: apply the default, silently)
  predator-mode -c             Cycle to the next profile
  predator-mode -l             List profiles (active and default marked)
  predator-mode -s             Show current profile, default and login service
  predator-mode -d [profile]   Set the default profile, or show it
  predator-mode --enable       Enable the login service (applies the default at login)
  predator-mode --disable      Disable the login service
  predator-mode -v             Show version
  predator-mode -h             Show this help

${BOLD}Profiles:${NC} ${AVAILABLE:-unavailable on this machine}

Install, update and uninstall: install-predator-mode.sh
EOF
}

# ── Entry point ───────────────────────────────────────────────────────────────

need_interface() {
    [ -f "$PROFILE_PATH" ] && return 0
    err "$PROFILE_PATH not found. This kernel does not expose ACPI platform profiles."
    exit 1
}

case "${1:-}" in
    -h|--help)    show_help ;;
    -v|--version) echo "predator-mode $VERSION" ;;
    --enable)     service_enable ;;
    --disable)    service_disable ;;
    -s|--status)  need_interface; show_status ;;
    -l|--list)    need_interface; show_list ;;
    -c|--cycle)   need_interface; cycle_profile ;;
    -d|--default) need_interface
                  if [ -z "${2:-}" ]; then get_default; else set_default "$2"; fi ;;
    "")           need_interface; set_profile "$(get_default)" silent ;;
    -*)           err "unknown option: $1"; echo "Try: predator-mode -h" >&2; exit 2 ;;
    *)            need_interface; set_profile "$1" ;;
esac
